+// POE R7: optional per-layer expert budget.
+//
+// POE_K_SCHEDULE is a comma-separated list of expert counts, one per layer
+// (e.g. "8,8,6,6,4,..."). A missing entry, or a value <= 0, leaves that layer
+// at the model's nominal top-k. Values are clamped so the schedule can only
+// *reduce* the number of experts executed, never raise it: the selection
+// tensor shrinks, so fewer expert matmuls are actually scheduled.
+static int64_t poe_layer_expert_budget(int il, int64_t n_expert_used) {
+    static std::vector<int> sched;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded = true;
+        const char * env = getenv("POE_K_SCHEDULE");
+        if (env) {
+            for (const char * p = env; *p; ) {
+                char * end = nullptr;
+                long v = strtol(p, &end, 10);
+                if (end == p) { break; }
+                sched.push_back((int) v);
+                p = end;
+                while (*p == 44 || *p == 32) { p++; }
+            }
+            LLAMA_LOG_INFO("POE: per-layer expert schedule loaded (%zu layers)\n", sched.size());
+        }
+    }
+    if (il < 0 || (size_t) il >= sched.size()) { return n_expert_used; }
+    const int64_t k = (int64_t) sched[il];
+    if (k <= 0 || k >= n_expert_used) { return n_expert_used; }
+    return k;
+}
+
