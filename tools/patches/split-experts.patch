+// POE split: hand mul_mat_id an ids tensor shaped the way the stock graph
+// does. The router's selection is a VIEW of the argsort output, so its rows
+// are strided by the full expert count; a compact tensor has rows only
+// n_expert_used wide. Pad back to full width and view the first n_expert_used
+// columns, so stride and provenance match what the CUDA path expects.
+static ggml_tensor * poe_ids_stock_layout(ggml_context * ctx0, ggml_tensor * f_ids,
+                                          int64_t n_expert, int64_t n_used,
+                                          int64_t n_tokens) {
+    ggml_tensor * wide = n_expert > n_used
+        ? ggml_pad(ctx0, f_ids, (int) (n_expert - n_used), 0, 0, 0)
+        : f_ids;
+    ggml_tensor * ids = ggml_cast(ctx0, wide, GGML_TYPE_I32);
+    return ggml_view_2d(ctx0, ids, n_used, n_tokens, ids->nb[1], 0);
+}
